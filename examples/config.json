{
  "tmux": {
    "claude": {
      "left": "cwd, session, pr, effort",
      "right": "version"
    },
    "tmux": {
      "left": "model, fast",
      "right": "warmth",
      "left.1": "heatmap_main",
      "left.2": "tokens, limits"
    }
  },
  "default": {
    "claude": {
      "left": "model, fast, cwd, session, pr, effort",
      "right": "version",
      "left.1": "tokens, limits",
      "left.2": "heatmap_main"
    }
  },
  "windowFlag": {
    "enabled": true,
    "format": "{claude} {dir} {git}",
    "markers": {
      "needsInput": "●",
      "working": "◐",
      "bgRunning": "⚙",
      "suspended": "⏸",
      "waiting": "",
      "idle": "",
      "unknown": "",
      "done": "⚑"
    },
    "git": {
      "ahead": "↑",
      "behind": "↓",
      "diverged": "↕",
      "dirty": "⚠",
      "clean": ""
    }
  }
}
